# NEXUS backend configuration. Copy to backend/.env and fill in.
# This file holds placeholders only - never commit real credentials.

# --- AI provider ----------------------------------------------------------
# ollama = free local model through Ollama (no API key, no usage cost).
# auto   = Anthropic when ANTHROPIC_API_KEY is set, otherwise "not configured".
# demo   = explicitly labeled offline demo: canned replies, no model, no tools.
NEXUS_PROVIDER=ollama

# --- Ollama (local) ---------------------------------------------------------
# Must be a model you have pulled (`ollama list`). Use a tool-capable model
# (qwen3, llama3.1, ...) so NEXUS can use its read-only file tools.
NEXUS_OLLAMA_MODEL=qwen3:4b
NEXUS_OLLAMA_URL=http://127.0.0.1:11434
# Context window requested from Ollama (tokens). More context uses more RAM.
NEXUS_OLLAMA_NUM_CTX=16384

# --- Anthropic (optional, paid) ----------------------------------------------
# Only used with NEXUS_PROVIDER=auto or anthropic. Read only by the backend.
ANTHROPIC_API_KEY=
# Alternative to an API key: an OAuth bearer token.
# ANTHROPIC_AUTH_TOKEN=
# Override the API endpoint (leave unset for https://api.anthropic.com).
# ANTHROPIC_BASE_URL=

NEXUS_MODEL=claude-opus-5-5
# Reasoning depth: low | medium | high | xhigh | max
NEXUS_EFFORT=medium
NEXUS_MAX_TOKENS=32000
# Re-run safety-classifier refusals on Anthropic's recommended fallback model.
NEXUS_REFUSAL_FALLBACK=true

# --- Storage ----------------------------------------------------------------
# NEXUS_DB_PATH=./data/nexus.db

# --- HTTP -----------------------------------------------------------------
NEXUS_CORS_ORIGINS=http://localhost:3000

# --- Tools ------------------------------------------------------------------
# Comma-separated ABSOLUTE folders the read-only file tools may access.
# Leave empty to disable file access entirely.
NEXUS_ALLOWED_DIRS=
NEXUS_MAX_TOOL_ITERATIONS=8
NEXUS_TOOL_TIMEOUT_SECONDS=10
# Max characters one tool call returns. ~20k suits a 16k-token local context;
# raise it (e.g. 60000) when using Anthropic.
NEXUS_MAX_READ_CHARS=20000
